    // Reproducir o pausar un BEAT
    function playBeat(beatId) {
      const beat = beatsData.find(b => b.id === beatId);
      if (!beat) return;

      // Si ya es el beat activo, alternar pausa/play
      if (activePlayback.type === 'beat' && activePlayback.beatId === beatId) {
        toggleCurrentAudio();
        return;
      }

      stopAllAudio();
      beat.plays += 1;

      activePlayback = {
        type: 'beat',
        beatId: beat.id,
        rapId: null,
        isPlaying: true,
        progress: 0,
        elapsedSec: 0,
        durationSec: 32
      };

      if (beat.audioUrl) {
        htmlAudio.src = beat.audioUrl;
        htmlAudio.play().catch(() => {});
        htmlAudio.onloadedmetadata = () => {
          if (isFinite(htmlAudio.duration)) {
            activePlayback.durationSec = htmlAudio.duration;
          }
        };
        htmlAudio.ontimeupdate = () => {
          if (activePlayback.type === 'beat' && activePlayback.beatId === beat.id) {
            activePlayback.elapsedSec = htmlAudio.currentTime;
            activePlayback.durationSec = isFinite(htmlAudio.duration) ? htmlAudio.duration : 30;
            activePlayback.progress = (activePlayback.elapsedSec / activePlayback.durationSec) * 100;
            updateProgressDOM();
          }
        };
        htmlAudio.onended = () => stopAllAudio();
      } else {
        startBoomBapSynth('beat', beat.bpm, beat.synthSeed);
        startSyntheticProgressTimer();
      }

      updateStickyPlayerUI(`${beat.title} (${beat.bpm} BPM)`, `Prod. ${beat.producer}`, 'BEAT');
      renderAll();
    }

    // Reproducir o pausar una TOMA DE RAP (.m4a)
    function playRap(beatId, rapId) {
      const beat = beatsData.find(b => b.id === beatId);
      if (!beat) return;
      const rap = beat.raps.find(r => r.id === rapId);
      if (!rap) return;

      if (activePlayback.type === 'rap' && activePlayback.rapId === rapId) {
        toggleCurrentAudio();
        return;
      }

      stopAllAudio();

      activePlayback = {
        type: 'rap',
        beatId: beat.id,
        rapId: rap.id,
        isPlaying: true,
        progress: 0,
        elapsedSec: 0,
        durationSec: rap.durationSec || 24
      };

      if (rap.audioUrl) {
        htmlAudio.src = rap.audioUrl;
        htmlAudio.play().catch(() => {});
        htmlAudio.onloadedmetadata = () => {
          if (isFinite(htmlAudio.duration)) {
            activePlayback.durationSec = htmlAudio.duration;
          }
        };
        htmlAudio.ontimeupdate = () => {
          if (activePlayback.type === 'rap' && activePlayback.rapId === rap.id) {
            activePlayback.elapsedSec = htmlAudio.currentTime;
            activePlayback.durationSec = isFinite(htmlAudio.duration) ? htmlAudio.duration : 24;
            activePlayback.progress = (activePlayback.elapsedSec / activePlayback.durationSec) * 100;
            updateProgressDOM();
          }
        };
        htmlAudio.onended = () => stopAllAudio();
      } else {
        startBoomBapSynth('rap', beat.bpm, rap.synthSeed);
        startSyntheticProgressTimer();
      }

      updateStickyPlayerUI(`${rap.fileName}`, `${rap.rapper} sobre "${beat.title}"`, 'RAP .M4A');
      renderAll();
    }

    function startSyntheticProgressTimer() {
      if (progressTimer) clearInterval(progressTimer);
      progressTimer = setInterval(() => {
        if (!activePlayback.isPlaying) return;
        activePlayback.elapsedSec += 0.25;
        if (activePlayback.elapsedSec >= activePlayback.durationSec) {
          activePlayback.elapsedSec = 0; // Loop continuo estilo MPC
        }
        activePlayback.progress = (activePlayback.elapsedSec / activePlayback.durationSec) * 100;
        updateProgressDOM();
      }, 250);
    }

    function updateProgressDOM() {
      document.getElementById('stickyCurrentTime').textContent = formatTime(activePlayback.elapsedSec);
      document.getElementById('stickyDuration').textContent = formatTime(activePlayback.durationSec);
      document.getElementById('stickyProgressBar').style.width = `${Math.min(100, activePlayback.progress)}%`;

      if (activePlayback.type === 'beat' && activePlayback.beatId) {
        const el = document.getElementById(`beat-prog-${activePlayback.beatId}`);
        if (el) el.style.width = `${Math.min(100, activePlayback.progress)}%`;
      }
      if (activePlayback.type === 'rap' && activePlayback.rapId) {
        const el = document.getElementById(`rap-prog-${activePlayback.rapId}`);
        if (el) el.style.width = `${Math.min(100, activePlayback.progress)}%`;
      }
    }

    function toggleCurrentAudio() {
      if (!activePlayback.type) return;
      activePlayback.isPlaying = !activePlayback.isPlaying;

      if (htmlAudio.src && !htmlAudio.ended && (
        (activePlayback.type === 'beat' && beatsData.find(b => b.id === activePlayback.beatId)?.audioUrl) ||
        (activePlayback.type === 'rap' && beatsData.find(b => b.id === activePlayback.beatId)?.raps.find(r => r.id === activePlayback.rapId)?.audioUrl)
      )) {
        if (activePlayback.isPlaying) htmlAudio.play();
        else htmlAudio.pause();
      } else {
        if (activePlayback.isPlaying) {
          const beat = beatsData.find(b => b.id === activePlayback.beatId);
          const rap = beat?.raps.find(r => r.id === activePlayback.rapId);
          startBoomBapSynth(activePlayback.type, beat?.bpm || 90, activePlayback.type === 'beat' ? beat?.synthSeed : rap?.synthSeed);
        } else {
          stopSynthesizer();
        }
      }

      document.getElementById('stickyPlayPauseBtn').textContent = activePlayback.isPlaying ? '⏸' : '▶';
      renderAll();
    }

    function seekGlobalAudio(event) {
      if (!activePlayback.type) return;
      const rect = event.currentTarget.getBoundingClientRect();
      const ratio = Math.max(0, Math.min(1, (event.clientX - rect.left) / rect.width));
      activePlayback.elapsedSec = ratio * activePlayback.durationSec;
      activePlayback.progress = ratio * 100;
      if (htmlAudio.src && isFinite(htmlAudio.duration)) {
        htmlAudio.currentTime = activePlayback.elapsedSec;
      }
      updateProgressDOM();
    }

