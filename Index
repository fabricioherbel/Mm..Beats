    // Calcula la suma de TODOS los fuegos (🔥) recibidos por un Beatmaker o Rapper
    function getArtistTotalFires(aka) {
      let total = 0;
      beatsData.forEach(beat => {
        if (beat.producer === aka) {
          total += (beat.likes || 0);
        }
        beat.raps.forEach(rap => {
          if (rap.rapper === aka) {
            total += (rap.likes || 0);
          }
        });
      });
      return total;
    }

    function getArtistMetrics(aka) {
      const profile = ensureArtistEntry(aka);
      const producedBeats = beatsData.filter(b => b.producer === aka);
      const recordedRaps = [];
      let totalPlays = 0;

      beatsData.forEach(beat => {
        if (beat.producer === aka) {
          totalPlays += (beat.plays || 0);
        }
        beat.raps.forEach(rap => {
          if (rap.rapper === aka) {
            recordedRaps.push({ ...rap, beatId: beat.id, beatTitle: beat.title, beatProducer: beat.producer });
            totalPlays += Math.max(12, (rap.likes || 1) * 4);
          }
        });
      });

      const totalFires = getArtistTotalFires(aka);

      // Posición en el ranking de su categoría
      const sameRoleArtists = Object.values(artistsDirectory)
        .filter(a => a.role === profile.role)
        .map(a => ({ aka: a.aka, fires: getArtistTotalFires(a.aka) }))
        .sort((a, b) => b.fires - a.fires);
      const rankIndex = sameRoleArtists.findIndex(item => item.aka === aka);

      return {
        profile,
        producedBeats,
        recordedRaps,
        totalFires,
        totalPlays,
        rank: rankIndex >= 0 ? rankIndex + 1 : '-'
      };
    }

