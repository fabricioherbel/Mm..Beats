<!DOCTYPE html>
<html lang="es" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>MM..BEATS | Beats Crudos & Notas de Voz Rap</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Graffiti / Marker / Monospace estilo underground -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=Permanent+Marker&family=Rubik+Spray+Paint&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            graffiti: ['"Rubik Spray Paint"', '"Permanent Marker"', 'cursive'],
            marker: ['"Permanent Marker"', 'cursive'],
            mono: ['"Space Mono"', 'monospace'],
            sans: ['"Inter"', 'sans-serif'],
          },
          colors: {
            markerGreen: '#39ff14',
            markerDark: '#16a34a',
            vinylBlack: '#09090b',
            comicPaper: '#111113',
            comicCard: '#18181b',
            doomGold: '#eab308',
            fireOrange: '#f97316',
            bloodRed: '#dc2626',
            darkBlood: '#7f1d1d',
            champBlue: '#1e3a8a',
            champRed: '#dc2626',
          }
        }
      }
    }
  </script>

  <style>
    /* Fondo estilo concreto / asfalto sucio Griselda x cómic underground */
    body {
      background-color: #09090b;
      background-image:
        radial-gradient(rgba(57, 255, 20, 0.06) 1px, transparent 0),
        radial-gradient(rgba(220, 38, 38, 0.05) 1px, transparent 0);
      background-size: 22px 22px;
      background-position: 0 0, 11px 11px;
      color: #f4f4f5;
      overflow-x: hidden;
    }

    /* Superposición de grano analógico / fotocopia VHS */
    .grimy-grain {
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.35'/%3E%3C/svg%3E");
    }

    /* Contorno brutalista tipo cinta cruda / historieta underground */
    .comic-box {
      border: 3px solid #000000;
      box-shadow: 5px 5px 0px #000000;
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .comic-box-green {
      border: 3px solid #000000;
      box-shadow: 5px 5px 0px #39ff14;
    }

    .comic-box-red {
      border: 3px solid #000000;
      box-shadow: 5px 5px 0px #dc2626;
    }

    .comic-btn {
      border: 2.5px solid #000000;
      box-shadow: 3px 3px 0px #000000;
      transition: all 0.12s ease;
    }

    .comic-btn:hover {
      transform: translate(-1px, -1px);
      box-shadow: 4px 4px 0px #000000;
    }

    .comic-btn:active {
      transform: translate(2px, 2px);
      box-shadow: 1px 1px 0px #000000;
    }

    /* Sello clásico Parental Advisory / Raw Tape */
    .parental-stamp {
      border: 2px solid #fff;
      outline: 2px solid #000;
      background: #000;
      color: #fff;
      font-family: 'Space Mono', monospace;
      line-height: 1;
      letter-spacing: 0.08em;
    }

    /* Efecto de texto graffiti con borde negro grueso */
    .graffiti-title {
      color: #39ff14;
      text-shadow:
        -2px -2px 0 #000,
         2px -2px 0 #000,
        -2px  2px 0 #000,
         2px  2px 0 #000,
         4px  4px 0 #000;
      letter-spacing: 0.03em;
    }

    .graffiti-sub {
      color: #39ff14;
      text-shadow:
        -1.5px -1.5px 0 #000,
         1.5px -1.5px 0 #000,
        -1.5px  1.5px 0 #000,
         1.5px  1.5px 0 #000,
         3px    3px 0 #000;
    }

    /* Scrollbar custom para listas de raps y chat DM */
    .raps-scroll::-webkit-scrollbar {
      width: 6px;
    }
    .raps-scroll::-webkit-scrollbar-track {
      background: #09090b;
      border-radius: 9999px;
    }
    .raps-scroll::-webkit-scrollbar-thumb {
      background: #39ff14;
      border: 1.5px solid #000;
      border-radius: 9999px;
    }

    /* Animación sutil para el emblema invertido */
    @keyframes stickerFloat {
      0%, 100% { transform: rotate(-3deg); }
      50% { transform: rotate(2deg); }
    }
    .sticker-badge {
      animation: stickerFloat 5s ease-in-out infinite;
    }

    /* Barras de ecualizador animadas cuando suena un audio */
    @keyframes eqBounce {
      0%, 100% { height: 25%; }
      50% { height: 95%; }
    }
    .eq-bar-1 { animation: eqBounce 0.55s infinite ease-in-out; }
    .eq-bar-2 { animation: eqBounce 0.40s infinite ease-in-out 0.15s; }
    .eq-bar-3 { animation: eqBounce 0.65s infinite ease-in-out 0.05s; }
    .eq-bar-4 { animation: eqBounce 0.48s infinite ease-in-out 0.25s; }
  </style>
</head>
<body class="min-h-screen font-sans antialiased selection:bg-markerGreen selection:text-black relative">

  <!-- TEXTURA ANALÓGICA / GRANO DE FOTOCOPIA EN TODA LA PANTALLA -->
  <div class="grimy-grain fixed inset-0 pointer-events-none z-50 opacity-[0.07]"></div>

  <!-- BARRA SUPERIOR DE NAVEGACIÓN: FEED, MI PERFIL, MENSAJES (DM) Y ROL -->
  <nav class="sticky top-0 z-40 bg-vinylBlack/95 backdrop-blur-md border-b-[3px] border-black px-3 sm:px-6 py-2.5">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-2">
      <!-- Izquierda: Acceso rápido a Feed + Estado de sesión con Fuegos Totales -->
      <div class="flex items-center gap-2 sm:gap-3">
        <button
          onclick="scrollToTopFeed()"
          class="comic-btn bg-zinc-900 hover:bg-zinc-800 text-markerGreen font-marker text-sm sm:text-base px-2.5 py-1 rounded-lg cursor-pointer tracking-wider"
          title="Volver al Feed Principal"
        >
          MM..FEED
        </button>

        <button
          onclick="openArtistProfileModal(currentUser.aka)"
          class="flex items-center gap-2 bg-zinc-900/90 hover:bg-zinc-800 border-2 border-black rounded-xl px-2.5 py-1 transition-colors cursor-pointer"
          title="Abrir Mi Perfil"
        >
          <div id="headerMiniAvatar" class="w-6 h-6 rounded-md border border-black overflow-hidden shrink-0"></div>
          <div class="text-xs font-mono text-left">
            <span id="headerUserName" class="font-bold text-white">@invitado_mc</span>
            <span id="headerUserRoleBadge" class="ml-1 px-1.5 py-0.5 text-[10px] font-bold uppercase rounded bg-doomGold text-black border border-black">
              Rapper
            </span>
          </div>
          <span id="headerUserFiresBadge" class="font-mono text-xs font-bold text-fireOrange bg-black px-1.5 py-0.5 rounded border border-zinc-800">
            🔥 0
          </span>
        </button>
      </div>

      <!-- Derecha: Mi Perfil, Mensajes (DM), Cambiar Rol y Subir Beat -->
      <div class="flex items-center gap-1.5 sm:gap-2.5">
        <button
          onclick="openArtistProfileModal(currentUser.aka)"
          class="comic-btn bg-zinc-800 hover:bg-zinc-700 text-white font-mono text-xs font-bold px-2.5 sm:px-3 py-1.5 rounded-lg flex items-center gap-1.5 cursor-pointer"
        >
          <span>🪪</span>
          <span class="hidden md:inline">Mi Perfil</span>
        </button>

        <button
          onclick="openDmModal()"
          class="comic-btn bg-zinc-800 hover:bg-zinc-700 text-white font-mono text-xs font-bold px-2.5 sm:px-3 py-1.5 rounded-lg flex items-center gap-1.5 cursor-pointer relative"
        >
          <span>✉️</span>
          <span class="hidden sm:inline">Mensajes (DM)</span>
          <span id="dmUnreadBadge" class="px-1.5 py-0.2 text-[10px] font-bold rounded-full bg-bloodRed text-white border border-black">
            2
          </span>
        </button>

        <button
          onclick="openAuthModal()"
          class="comic-btn bg-zinc-900 hover:bg-zinc-800 text-zinc-200 font-mono text-xs font-bold px-2.5 sm:px-3 py-1.5 rounded-lg flex items-center gap-1.5 cursor-pointer"
        >
          <span>🎭</span>
          <span class="hidden lg:inline">Cuenta / Rol</span>
        </button>

        <button
          onclick="handleUploadBeatClick()"
          class="comic-btn bg-markerGreen hover:bg-green-300 text-black font-mono text-xs font-bold px-3 py-1.5 rounded-lg flex items-center gap-1 cursor-pointer"
        >
          <span>🎹</span>
          <span>+ Beat</span>
        </button>
      </div>
    </div>
  </nav>

  <!-- CONTENEDOR PRINCIPAL -->
  <main class="max-w-7xl mx-auto px-3 sm:px-6 pt-5 pb-20">

    <!-- =====================================================================
         1. CABECERA PRINCIPAL: LOGO MM.. [C INVERTIDA] BEATS (IGUAL AL BOCETO)
         ===================================================================== -->
    <header class="flex flex-col items-center justify-center mb-6 select-none">
      <div class="flex items-center justify-center gap-2 sm:gap-4 flex-wrap">
        <!-- Texto izquierdo: MM.. -->
        <h1 class="font-graffiti text-5xl sm:text-7xl md:text-8xl graffiti-title tracking-tight leading-none">
          MM..
        </h1>

        <!-- LOGO SVG INSPIRADO EN EL STICKER DE CHAMPION INVERTIDO DEL BOCETO -->
        <div class="sticker-badge relative w-16 h-16 sm:w-22 sm:h-22 md:w-24 md:h-24 flex items-center justify-center" title="MM..BEATS Emblem">
          <svg viewBox="0 0 120 120" class="w-full h-full drop-shadow-[4px_4px_0px_rgba(0,0,0,1)]">
            <!-- Sticker circular blanco vintage con borde negro -->
            <circle cx="60" cy="60" r="55" fill="#f8fafc" stroke="#000000" stroke-width="5" />
            <circle cx="60" cy="60" r="48" fill="none" stroke="#cbd5e1" stroke-width="1.5" stroke-dasharray="4 3" />

            <!-- Grupo rotado 180 grados (emblema invertido exactamente como la pegatina del boceto) -->
            <g transform="rotate(180 60 60)">
              <!-- C exterior azul marino gruesa estilo varsity/sport -->
              <path
                d="M 82 42
                   C 76 31, 65 26, 53 27
                   C 35 29, 24 43, 24 60
                   C 24 77, 35 91, 53 93
                   C 65 94, 76 89, 82 78
                   L 68 70
                   C 64 76, 59 79, 53 78
                   C 43 77, 38 69, 38 60
                   C 38 51, 43 43, 53 42
                   C 59 41, 64 44, 68 50 Z"
                fill="#1e3a8a"
                stroke="#000000"
                stroke-width="3"
                stroke-linejoin="round"
              />
              <!-- Media luna / barra roja interior característica -->
              <path
                d="M 65 49
                   C 59 44, 49 46, 46 54
                   C 43 61, 46 71, 55 74
                   C 60 75, 64 73, 66 70
                   L 85 70
                   C 85 66, 85 54, 85 50
                   L 65 49 Z"
                fill="#dc2626"
                stroke="#000000"
                stroke-width="2.5"
                stroke-linejoin="round"
              />
            </g>
          </svg>
        </div>

        <!-- Texto derecho: BEATS -->
        <span class="font-graffiti text-5xl sm:text-7xl md:text-8xl graffiti-title tracking-tight leading-none">
          BEATS
        </span>
      </div>
      <p class="mt-2 font-mono text-xs sm:text-sm text-zinc-300 bg-black/90 border-2 border-zinc-800 px-3.5 py-1 rounded-full text-center flex flex-wrap items-center justify-center gap-2">
        <span class="text-bloodRed font-bold">[RAW TAPE // 187 PROOF]</span>
        <span>Sube tu beat • Tira tu nota de voz <span class="text-markerGreen font-bold">.m4a</span> desde el celu • Sin mezcla</span>
      </p>
    </header>

    <!-- =====================================================================
         2. RANKINGS SUPERIORES: "TOP PROD" & "TOP RAPS" (ORDENADOS POR 🔥)
         ===================================================================== -->
    <section aria-label="Rankings de Productores y Raperos" class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 mb-8 max-w-5xl mx-auto">
      <!-- Cuadro Izquierdo: TOP PROD -->
      <div class="comic-box bg-comicCard rounded-2xl p-4 relative overflow-hidden">
        <div class="flex items-center justify-between border-b-2 border-black pb-2 mb-3">
          <h2 class="font-marker text-2xl sm:text-3xl graffiti-sub tracking-wide flex items-center gap-2">
            <span>TOP PROD</span>
            <span class="text-base bg-markerGreen text-black font-mono font-bold px-2 py-0.5 rounded-md border border-black not-italic">👑</span>
          </h2>
          <span class="font-mono text-[11px] text-zinc-400 uppercase">Clic para ver perfil • 🔥</span>
        </div>
        <ol id="topProdList" class="space-y-2 font-mono text-sm">
          <!-- Renderizado dinámico por JS -->
        </ol>
      </div>

      <!-- Cuadro Derecho: TOP RAPS -->
      <div class="comic-box bg-comicCard rounded-2xl p-4 relative overflow-hidden">
        <div class="flex items-center justify-between border-b-2 border-black pb-2 mb-3">
          <h2 class="font-marker text-2xl sm:text-3xl graffiti-sub tracking-wide flex items-center gap-2">
            <span>TOP RAPS</span>
            <span class="text-base bg-doomGold text-black font-mono font-bold px-2 py-0.5 rounded-md border border-black not-italic">🔥</span>
          </h2>
          <span class="font-mono text-[11px] text-zinc-400 uppercase">Fuegos totales (.m4a)</span>
        </div>
        <ol id="topRapsList" class="space-y-2 font-mono text-sm">
          <!-- Renderizado dinámico por JS -->
        </ol>
      </div>
    </section>

    <!-- =====================================================================
         3. FEED PRINCIPAL "TOP" (FILAS ANCHAS: COVER | BEAT | RAPS/COMMENTS)
         ===================================================================== -->
    <section aria-label="Top Beats y Raps" class="mb-8">
      <!-- Indicador "TOP ↓" a la izquierda tal como dibujaste en el boceto -->
      <div class="flex items-center gap-3 mb-3 pl-1">
        <div class="flex items-center gap-1.5">
          <span class="font-marker text-2xl sm:text-3xl graffiti-sub">TOP</span>
          <svg class="w-6 h-6 text-markerGreen drop-shadow-[2px_2px_0px_#000]" fill="none" stroke="currentColor" stroke-width="3.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m0 0l-6-6m6 6l6-6" />
          </svg>
        </div>
        <div class="h-[3px] flex-1 bg-markerGreen border-y border-black rounded-full"></div>
        <span class="font-mono text-xs text-zinc-400 hidden sm:inline">Dale play al beat o escucha las tomas de voz a la derecha</span>
      </div>

      <!-- Contenedor de tarjetas horizontales de TOP BEATS -->
      <div id="topBeatsFeed" class="space-y-6">
        <!-- Renderizado dinámico por JS -->
      </div>
    </section>

    <!-- =====================================================================
         4. SEPARADOR DE FLECHAS VERDES (→ → → → →) DEL BOCETO
         ===================================================================== -->
    <div class="my-8 py-2 border-y-[3px] border-black bg-comicPaper/90 rounded-xl flex items-center justify-around px-4 select-none overflow-hidden">
      <span class="font-marker text-2xl sm:text-3xl text-markerGreen drop-shadow-[2px_2px_0px_#000]">→</span>
      <span class="font-marker text-2xl sm:text-3xl text-markerGreen drop-shadow-[2px_2px_0px_#000]">→</span>
      <span class="font-marker text-2xl sm:text-3xl text-markerGreen drop-shadow-[2px_2px_0px_#000]">→</span>
      <span class="font-marker text-2xl sm:text-3xl text-markerGreen drop-shadow-[2px_2px_0px_#000]">→</span>
      <span class="font-marker text-2xl sm:text-3xl text-markerGreen drop-shadow-[2px_2px_0px_#000] hidden sm:inline">→</span>
      <span class="font-marker text-2xl sm:text-3xl text-markerGreen drop-shadow-[2px_2px_0px_#000] hidden md:inline">→</span>
    </div>

    <!-- =====================================================================
         5. SECCIÓN INFERIOR "NEW BEATS" (GRILLA DE 2 COLUMNAS DEL BOCETO)
         ===================================================================== -->
    <section aria-label="New Beats">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-5">
        <div class="flex items-center gap-3">
          <h2 class="font-graffiti text-3xl sm:text-4xl graffiti-sub tracking-wide">
            NEW BEATS
          </h2>
          <span class="font-mono text-xs bg-markerGreen text-black font-bold px-2.5 py-0.5 rounded-md border-2 border-black">
            RECIÉN SALIDOS
          </span>
        </div>
        <p class="font-mono text-xs text-zinc-400">
          Sé el primero en tirar un freestyle en <span class="text-markerGreen font-bold">.m4a</span> sobre los beats nuevos
        </p>
      </div>

      <!-- Grilla de 2 columnas igual que en la parte inferior del dibujo -->
      <div id="newBeatsGrid" class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-5">
        <!-- Renderizado dinámico por JS -->
      </div>
    </section>

  </main>

  <!-- =====================================================================
       REPRODUCTOR FLOTANTE INFERIOR (PERSISTENTE AL REPRODUCIR CUALQUIER PISTA)
       ===================================================================== -->
  <div id="stickyPlayer" class="fixed bottom-0 inset-x-0 z-40 bg-zinc-950/95 backdrop-blur-md border-t-[3px] border-markerGreen px-3 sm:px-6 py-2.5 hidden">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-3">
      <div class="flex items-center gap-3 min-w-0">
        <button id="stickyPlayPauseBtn" onclick="toggleCurrentAudio()" class="comic-btn w-10 h-10 rounded-xl bg-markerGreen text-black flex items-center justify-center font-bold shrink-0 cursor-pointer">
          ⏸
        </button>
        <div class="min-w-0">
          <div class="flex items-center gap-2">
            <span id="stickyBadgeType" class="text-[10px] font-mono font-bold uppercase px-1.5 py-0.5 rounded bg-doomGold text-black border border-black">BEAT</span>
            <p id="stickyTrackTitle" class="font-bold text-sm text-white truncate">Título de pista</p>
          </div>
          <p id="stickyTrackSub" class="font-mono text-xs text-zinc-400 truncate">@artista</p>
        </div>
      </div>

      <!-- Barra de progreso global -->
      <div class="hidden sm:flex items-center gap-3 flex-1 max-w-md">
        <span id="stickyCurrentTime" class="font-mono text-xs text-zinc-400 w-10 text-right">0:00</span>
        <div onclick="seekGlobalAudio(event)" class="flex-1 h-3 bg-zinc-800 rounded-full border-2 border-black overflow-hidden cursor-pointer relative">
          <div id="stickyProgressBar" class="h-full bg-markerGreen w-0 transition-all duration-100"></div>
        </div>
        <span id="stickyDuration" class="font-mono text-xs text-zinc-400 w-10">0:30</span>
      </div>

      <button onclick="stopAllAudio()" class="comic-btn bg-zinc-800 hover:bg-red-600 text-white font-mono text-xs px-2.5 py-1.5 rounded-lg cursor-pointer shrink-0">
        ✕ Parar
      </button>
    </div>
  </div>

  <!-- =====================================================================
       MODAL 1: REGISTRO / SELECCIÓN DE ROL (BEATMAKER vs RAPPER)
       ===================================================================== -->
  <div id="authModal" class="fixed inset-0 z-50 bg-black/85 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="comic-box-green bg-comicCard rounded-2xl max-w-md w-full p-5 sm:p-6 relative max-h-[92vh] overflow-y-auto">
      <button onclick="closeModal('authModal')" class="comic-btn absolute top-4 right-4 w-8 h-8 rounded-lg bg-zinc-800 text-white font-bold cursor-pointer">✕</button>

      <div class="inline-block parental-stamp text-[9px] px-2 py-0.5 mb-2">RAW CREDENTIALS // MM..BEATS</div>
      <h3 class="font-graffiti text-3xl graffiti-sub mb-1">PERFIL Y ROL</h3>
      <p class="font-mono text-xs text-zinc-300 mb-4">
        La web es idéntica para todos, pero tu rol define qué tipo de archivos podés subir.
      </p>

      <form onsubmit="submitRegistration(event)" class="space-y-3.5">
        <div>
          <label class="block font-mono text-xs font-bold uppercase text-markerGreen mb-1">
            Tu AKA / Nombre Artístico *
          </label>
          <input
            id="regUsernameInput"
            type="text"
            required
            maxlength="24"
            placeholder="Ej: Westside_Sur, Daringer_BA..."
            class="w-full bg-zinc-950 border-2 border-black focus:border-markerGreen rounded-xl px-3.5 py-2 text-white font-mono text-sm outline-none"
          />
        </div>

        <div class="grid grid-cols-2 gap-2.5">
          <div>
            <label class="block font-mono text-[11px] font-bold uppercase text-zinc-400 mb-1">
              Ciudad / Barrio
            </label>
            <input
              id="regCityInput"
              type="text"
              maxlength="24"
              placeholder="Ej: Buffalo / Zona Sur"
              class="w-full bg-zinc-950 border-2 border-black focus:border-markerGreen rounded-xl px-3 py-1.5 text-white font-mono text-xs outline-none"
            />
          </div>
          <div>
            <label class="block font-mono text-[11px] font-bold uppercase text-zinc-400 mb-1">
              Sello / Crew
            </label>
            <input
              id="regCrewInput"
              type="text"
              maxlength="24"
              placeholder="Ej: Grimy Tape Dept."
              class="w-full bg-zinc-950 border-2 border-black focus:border-markerGreen rounded-xl px-3 py-1.5 text-white font-mono text-xs outline-none"
            />
          </div>
        </div>

        <div>
          <label class="block font-mono text-[11px] font-bold uppercase text-zinc-400 mb-1">
            Bio Cruda (aparece en tu dossier)
          </label>
          <input
            id="regBioInput"
            type="text"
            maxlength="90"
            placeholder="Ej: Loops sucios de vinilo y barras grabadas en una toma..."
            class="w-full bg-zinc-950 border-2 border-black focus:border-markerGreen rounded-xl px-3 py-1.5 text-white font-mono text-xs outline-none"
          />
        </div>

        <div>
          <label class="block font-mono text-xs font-bold uppercase text-markerGreen mb-2">
            ¿Cuál es tu rol en el estudio?
          </label>
          <div class="grid grid-cols-2 gap-3">
            <!-- Opción Beatmaker -->
            <label class="cursor-pointer">
              <input type="radio" name="userRole" value="Beatmaker" class="peer sr-only" />
              <div class="comic-btn peer-checked:bg-markerGreen peer-checked:text-black bg-zinc-900 text-zinc-200 rounded-xl p-3 text-center transition-all">
                <div class="text-2xl mb-1">🎛️</div>
                <div class="font-marker text-lg tracking-wide">BEATMAKER</div>
                <div class="font-mono text-[11px] opacity-85 mt-1">
                  Sube beats (.mp3, .wav)
                </div>
              </div>
            </label>

            <!-- Opción Rapper -->
            <label class="cursor-pointer">
