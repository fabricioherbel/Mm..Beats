    async function toggleMicRecording() {
      if (mediaRecorder && mediaRecorder.state === 'recording') {
        stopMicRecordingIfActive();
        return;
      }

      try {
        const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
        recordedChunks = [];
        mediaRecorder = new MediaRecorder(stream);

        mediaRecorder.ondataavailable = (e) => {
          if (e.data.size > 0) recordedChunks.push(e.data);
        };

        mediaRecorder.onstop = () => {
          const blob = new Blob(recordedChunks, { type: 'audio/webm' });
          recordedBlobUrl = URL.createObjectURL(blob);
          const previewEl = document.getElementById('micPreviewAudio');
          previewEl.src = recordedBlobUrl;
          previewEl.classList.remove('hidden');
          stream.getTracks().forEach(t => t.stop());
        };

        mediaRecorder.start();
        recSeconds = 0;
        document.getElementById('recBtnLabel').textContent = 'Detener Grabación';
        document.getElementById('recDot').classList.add('animate-ping');

        recInterval = setInterval(() => {
          recSeconds++;
          const mins = String(Math.floor(recSeconds / 60)).padStart(2, '0');
          const secs = String(recSeconds % 60).padStart(2, '0');
          document.getElementById('recTimerDisplay').textContent = `${mins}:${secs}`;
        }, 1000);
      } catch (err) {
        showToast('No se pudo acceder al micrófono. Podés subir un archivo .m4a');
      }
    }

    function stopMicRecordingIfActive() {
      if (recInterval) {
        clearInterval(recInterval);
        recInterval = null;
      }
      if (mediaRecorder && mediaRecorder.state === 'recording') {
        mediaRecorder.stop();
      }
      document.getElementById('recBtnLabel').textContent = 'Grabar Toma';
      document.getElementById('recDot').classList.remove('animate-ping');
    }

