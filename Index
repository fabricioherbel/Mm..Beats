    function renderLeaderboards() {
      // 1. TOP PROD ordenado por Fuegos Totales (🔥) recibidos en sus beats
      const prodAkas = new Set([
        ...Object.values(artistsDirectory).filter(a => a.role === 'Beatmaker').map(a => a.aka),
        ...beatsData.map(b => b.producer)
      ]);

      const sortedProds = Array.from(prodAkas)
        .map(aka => {
          const fires = getArtistTotalFires(aka);
          const plays = beatsData.filter(b => b.producer === aka).reduce((acc, b) => acc + b.plays, 0);
          return { aka, fires, plays };
        })
        .sort((a, b) => b.fires - a.fires || b.plays - a.plays)
        .slice(0, 3);

      document.getElementById('topProdList').innerHTML = sortedProds.map((item, idx) => `
        <li
          onclick="openArtistProfileModal('${item.aka}')"
          class="flex items-center justify-between bg-zinc-900/90 hover:bg-zinc-800 border-2 border-black rounded-xl px-3 py-2 cursor-pointer transition-colors group"
          title="Abrir perfil de ${item.aka}"
        >
          <div class="flex items-center gap-2.5 min-w-0">
            <span class="w-6 h-6 rounded-lg ${idx === 0 ? 'bg-markerGreen text-black' : 'bg-zinc-800 text-markerGreen'} border border-black font-bold flex items-center justify-center shrink-0">
              ${idx + 1}
            </span>
            <span class="font-bold text-white group-hover:text-markerGreen truncate">${item.aka}</span>
          </div>
          <div class="flex items-center gap-2 shrink-0">
            <span class="text-[11px] text-zinc-400 hidden sm:inline">${item.plays} plays</span>
            <span class="text-xs text-fireOrange font-bold bg-black px-2 py-0.5 rounded border border-zinc-800">🔥 ${item.fires}</span>
          </div>
        </li>
      `).join('');

      // 2. TOP RAPS ordenado por Fuegos Totales (🔥) acumulados por cada Rapper
      const rapAkas = new Set();
      beatsData.forEach(b => b.raps.forEach(r => rapAkas.add(r.rapper)));

      const sortedRappers = Array.from(rapAkas)
        .map(aka => {
          const fires = getArtistTotalFires(aka);
          let takesCount = 0;
          beatsData.forEach(b => b.raps.forEach(r => { if (r.rapper === aka) takesCount++; }));
          return { aka, fires, takesCount };
        })
        .sort((a, b) => b.fires - a.fires)
        .slice(0, 3);

      document.getElementById('topRapsList').innerHTML = sortedRappers.map((item, idx) => `
        <li
          onclick="openArtistProfileModal('${item.aka}')"
          class="flex items-center justify-between bg-zinc-900/90 hover:bg-zinc-800 border-2 border-black rounded-xl px-3 py-2 cursor-pointer transition-colors group"
          title="Abrir perfil de ${item.aka}"
        >
          <div class="flex items-center gap-2.5 min-w-0">
            <span class="w-6 h-6 rounded-lg ${idx === 0 ? 'bg-doomGold text-black' : 'bg-zinc-800 text-doomGold'} border border-black font-bold flex items-center justify-center shrink-0">
              ${idx + 1}
            </span>
            <div class="truncate">
              <span class="font-bold text-white group-hover:text-doomGold">${item.aka}</span>
              <span class="text-[11px] text-zinc-400 ml-1">(${item.takesCount} .m4a)</span>
            </div>
          </div>
          <span class="text-xs text-fireOrange font-bold bg-black px-2 py-0.5 rounded border border-zinc-800 shrink-0">🔥 ${item.fires}</span>
        </li>
      `).join('');
    }

