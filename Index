          </div>
          <div>
            <span class="font-mono text-xs text-markerGreen font-bold">${beat.bpm} BPM • Key ${beat.musicalKey} • ${beat.formatTag || '.WAV'}</span>
            <h3 class="font-extrabold text-2xl text-white">${beat.title}</h3>
            <p class="font-mono text-xs text-zinc-400">
              Prod.
              <button
                type="button"
                onclick="closeModal('beatDetailModal'); openArtistProfileModal('${beat.producer}')"
                class="text-markerGreen hover:underline font-bold cursor-pointer"
              >
                ${beat.producer}
              </button>
            </p>
          </div>
        </div>

        <div class="flex flex-wrap gap-2.5 mb-5">
          <button
            onclick="playBeat('${beat.id}'); openBeatDetailModal('${beat.id}')"
            class="comic-btn bg-markerGreen text-black font-mono text-xs font-bold px-4 py-2 rounded-xl cursor-pointer"
          >
            ${isPlayingThisBeat ? '⏸ Pausar Beat' : '▶ Escuchar Beat'}
          </button>
          <button
            onclick="toggleLikeBeat('${beat.id}')"
            class="comic-btn ${beat.likedByMe ? 'bg-fireOrange text-black' : 'bg-zinc-800 text-white'} font-mono text-xs font-bold px-3.5 py-2 rounded-xl cursor-pointer"
          >
            🔥 Fuego (${beat.likes || 0})
          </button>
          <button
            onclick="handleAddRapClick('${beat.id}')"
            class="comic-btn bg-doomGold text-black font-mono text-xs font-bold px-4 py-2 rounded-xl cursor-pointer"
          >
            🎤 + Subir mi Rap (.m4a / Mic)
          </button>
        </div>

        <h4 class="font-marker text-lg text-markerGreen mb-2.5">
          TOMAS Y COMENTARIOS DE RAPPERS (${beat.raps.length})
        </h4>
        <div class="space-y-2.5 max-h-72 overflow-y-auto raps-scroll pr-1">
          ${beat.raps.length > 0
            ? beat.raps.map(rap => renderRapRowItem(beat.id, rap)).join('')
            : `<p class="font-mono text-xs text-zinc-400 bg-zinc-900 border border-black rounded-xl p-4 text-center">
                 Aún nadie grabó sobre este beat. ¡Estrenalo con una nota de voz desde tu celu!
               </p>`
          }
        </div>
      `;

      openModal('beatDetailModal');
    }

    function renderAll() {
      renderLeaderboards();
      renderTopBeatsFeed();
      renderNewBeatsGrid();
    }

    // -----------------------------------------------------------------------
    // 8. UTILIDADES DE MODALES Y TOAST
    // -----------------------------------------------------------------------
    function openModal(id) {
      const el = document.getElementById(id);
      el.classList.remove('hidden');
      el.classList.add('flex');
    }

    function closeModal(id) {
      const el = document.getElementById(id);
      el.classList.add('hidden');
      el.classList.remove('flex');
    }

    function openAuthModal() {
      document.getElementById('regUsernameInput').value = currentUser.aka.replace(/^@/, '');
      document.getElementById('regCityInput').value = currentUser.city || '';
      document.getElementById('regCrewInput').value = currentUser.crew || '';
      document.getElementById('regBioInput').value = currentUser.bio || '';
      const radios = document.querySelectorAll('input[name="userRole"]');
      radios.forEach(r => { r.checked = (r.value === currentUser.role); });
      openModal('authModal');
    }

    let toastTimeout = null;
    function showToast(msg) {
      const toast = document.getElementById('toastNotification');
      document.getElementById('toastMessage').textContent = msg;
      toast.classList.remove('hidden');
      toast.classList.add('flex');
      if (toastTimeout) clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        toast.classList.add('hidden');
        toast.classList.remove('flex');
      }, 3400);
    }

    // Inicialización al cargar la página
    window.addEventListener('DOMContentLoaded', () => {
      updateHeaderUserUI();
      renderAll();
    });
  </script>
</body>
</html>
