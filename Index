    // -----------------------------------------------------------------------
    // MOTOR DE AUDIO (ARCHIVOS REALES + SINTETIZADOR BOOM-BAP WEB AUDIO)
    // -----------------------------------------------------------------------
    function stopSynthesizer() {
      if (synthInterval) {
        clearInterval(synthInterval);
        synthInterval = null;
      }
    }

    function stopAllAudio() {
      htmlAudio.pause();
      htmlAudio.currentTime = 0;
      stopSynthesizer();
      if (progressTimer) {
        clearInterval(progressTimer);
        progressTimer = null;
      }
      activePlayback = {
        type: null,
        beatId: null,
        rapId: null,
        isPlaying: false,
        progress: 0,
        elapsedSec: 0,
        durationSec: 32
