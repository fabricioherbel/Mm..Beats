    function handleSendDmSubmit(event) {
      event.preventDefault();
      if (!activeDmPartner) return;

      const input = document.getElementById('dmMessageInput');
      const beatSelect = document.getElementById('dmAttachBeatSelect');
      const text = input.value.trim();
      const beatRefId = beatSelect.value || null;

      if (!text && !beatRefId) return;

      const thread = dmConversations.find(c => c.partnerAka === activeDmPartner);
      if (!thread) return;

      const now = new Date();
      const timeStr = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;

      thread.messages.push({
        sender: currentUser.aka,
        text: text || 'Te comparto este beat de MM..BEATS:',
        time: timeStr,
        beatRefId: beatRefId
      });

      input.value = '';
      beatSelect.value = '';
      renderDmModal();

      // Respuesta realista del estudio si es la primera vez que le escribís en la sesión
      if (!thread.autoReplied) {
        thread.autoReplied = true;
        const partnerObj = ensureArtistEntry(activeDmPartner);
        setTimeout(() => {
          const replyText = partnerObj.role === 'Beatmaker'
            ? 'De una hermano, tirate una nota de voz .m4a encima y si queda asesina armamos el track completo.'
            : 'Dale de una, mandame el link del instrumental y hoy mismo le grabo una toma cruda.';
          thread.messages.push({
            sender: activeDmPartner,
            text: replyText,
            time: timeStr,
            beatRefId: null
          });
          if (document.getElementById('dmModal').classList.contains('hidden')) {
            thread.unread = true;
            updateDmUnreadBadge();
            showToast(`Nuevo DM de ${activeDmPartner}`);
          } else {
            renderDmModal();
          }
        }, 1200);
      }
    }

